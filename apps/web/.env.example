NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side aliases are also supported by station and price APIs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
OSRM_BASE_URL=
OPENROUTESERVICE_API_KEY=
# Optional AI assistant (server-only). Free key: https://aistudio.google.com/apikey
# Without a key the assistant gives the basic rule-based answer.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional free fallback when Gemini is out of quota: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Trip planner geo service (optional). Without GEO_FUNCTION_URL the same code runs in-process.
# Example: https://<project-ref>.supabase.co/functions/v1/geo
GEO_FUNCTION_URL=
# Optional free geocoding fallback (public Nominatim: 1 request/second, contact email required)
NOMINATIM_BASE_URL=
NOMINATIM_CONTACT_EMAIL=
# Show fictional [DEMO] businesses in search (local demos only)
SHOW_DEMO_BUSINESSES=
